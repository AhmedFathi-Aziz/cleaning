# عنوان الموقع العام (لـ canonical و sitemap و JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.itqan.com.sa

# كلمة مرور لوحة المحرّر (/admin) — ليست مفتاح طرف ثالث. محلياً: ضعها في .env.local
# على Cloudflare: npx wrangler secret put ADMIN_PASSWORD
ADMIN_PASSWORD=

# التخزين: المشروع يستخدم Workers KV (binding ARTICLES) افتراضياً.
# عند تفعيل R2 في الحساب يمكنك إضافة r2_buckets binding MEDIA في wrangler.jsonc.
